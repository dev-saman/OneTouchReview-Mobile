# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Firebase mobile config: kept locally, supplied to EAS as file env vars (never committed)
google-services.json
GoogleService-Info.plist

# local env (keep .env.example committed)
.env
.env.*
!.env.example

# API response captures from scripts/capture-responses.mjs (may contain test-business data)
.api-captures/

# signing material
*.keystore
credentials.json
